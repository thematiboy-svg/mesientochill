# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon

# Formularios (contacto y alta del piloto): se envían por email con Resend
RESEND_API_KEY=tu-clave-de-resend
CONTACT_TO_EMAIL=info@mesientochill.com
# Opcional: remitente verificado en Resend (por defecto onboarding@resend.dev)
# CONTACT_FROM_EMAIL=MeSientoChill <web@mesientochill.com>

# Supabase, solo servidor: clave service_role (la usa el webhook de Stripe). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# Stripe (suscripciones, eventos y audios). Empieza con las claves de prueba (sk_test_…).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_VIDEOS=price_...
STRIPE_PRICE_DIRECTO=price_...
# Opcional: calcular el IVA con Stripe Tax (on para activarlo)
# STRIPE_TAX=on
# Opcional: URL pública para volver desde Stripe (si no, se usa la del navegador)
# NEXT_PUBLIC_SITE_URL=https://mesientochill.com
